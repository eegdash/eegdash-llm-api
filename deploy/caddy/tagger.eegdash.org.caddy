# Caddy site block for the EEGDash LLM Tagger API.
#
# STRICT ORDERING — do NOT append this block until DNS resolves, or Caddy will
# hammer ACME for a non-resolving name and can hit Let's Encrypt failed-validation
# rate limits (shared with data.eegdash.org's ACME account):
#   1) Create A record:  tagger.eegdash.org  ->  169.228.38.92
#   2) Verify from the host AND externally:  dig +short tagger.eegdash.org   (== 169.228.38.92)
#   3) Back up the Caddyfile, append this block, then:
#        docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#        docker exec caddy caddy reload   --config /etc/caddy/Caddyfile
# A failed `validate` must NOT be reloaded; the running config stays live either way.
#
# EDGE AUTH (important): /api/v1/tag and /tag/enqueue spend the server's OpenRouter
# key, and DELETE /api/v1/cache wipes the cache. The app gates those routes on the
# X-API-Key header (TAGGER_API_KEY); the edge gate below checks the SAME header and
# drops anonymous traffic before it reaches the app. Because both check one header,
# the token here must be the same value as TAGGER_API_KEY in deploy/.env, or every
# gated call fails one of the two checks.
# NOTE: this gates the PUBLIC path only; containers on eegdash-competition_backend
# can still reach tagger-api:8000 directly, bypassing Caddy (accepted trust boundary).

tagger.eegdash.org {
  encode gzip zstd

  # Tagging requests/responses are small JSON; cap the body at the edge. A 4MB
  # batch-enqueue body can still be thousands of jobs — keep enqueue internal-only
  # or tighten this if the batch endpoint is ever exposed.
  request_body {
    max_size 4MB
  }

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }

  # Block requests with empty/missing Host header.
  @no_host {
    not header Host *
  }
  respond @no_host 400

  # --- Edge API-key gate (stock Caddy, no plugin) ---
  # Replace REPLACE_WITH_LONG_RANDOM_TOKEN with the same value as TAGGER_API_KEY
  # (deploy/.env). Callers must send: X-API-Key: <token>.
  # To use HTTP basic-auth instead (like /grafana), swap this for a basic_auth block.
  @noauth not header X-API-Key "REPLACE_WITH_LONG_RANDOM_TOKEN"
  respond @noauth "Forbidden" 403

  # Destructive and bulk routes stay internal-only (DEPLOYMENT_PLAN): the
  # tagging key alone must not wipe the cache or queue thousands of LLM jobs
  # from the internet. Operators use them via docker exec on the host.
  @internal_only {
    method DELETE
  }
  respond @internal_only "Forbidden" 403
  @internal_paths path /api/v1/tag/enqueue /api/v1/tag/enqueue/*
  respond @internal_paths "Forbidden" 403

  reverse_proxy tagger-api:8000 {
    health_uri /health
    health_interval 30s
    health_timeout 5s

    # Sync /api/v1/tag clones a repo (up to 120s) + calls the LLM (up to
    # LLM_TIMEOUT=300s) and may wait behind another tag; keep the edge above
    # the client's 300s budget so finished, paid-for tags are not 504'd.
    transport http {
      read_timeout 330s
      write_timeout 330s
    }

    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }

  log {
    output file /var/log/caddy/tagger-access.log {
      roll_size 100mb
      roll_keep 5
    }
    # Request headers are logged; redact the API key so it never hits disk.
    # This filter covers the ACCESS log only. Caddy's error log (5xx, e.g. 502
    # during a restart) also records request headers: add the same filter to
    # the host Caddyfile's global `log default { format filter ... }`.
    format filter {
      wrap json
      fields {
        request>headers>X-Api-Key replace REDACTED
      }
    }
  }
}
