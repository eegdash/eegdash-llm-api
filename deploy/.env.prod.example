# Production environment for deploy/docker-compose.prod.yml
# Copy to `deploy/.env`, fill in, then: chmod 600 deploy/.env
# NEVER commit this file or bake it into the image (both repos are PUBLIC).

# --- LLM (required) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Use a DEDICATED OpenRouter key for this service with a hard daily credit cap
# (dashboard: limit + limit_reset=daily). That cap is the real spend backstop.
#
# Choose the model DELIBERATELY. openai/gpt-4-turbo is the code default but is a
# high-cost legacy model; combined with the unbounded /tag/enqueue/batch endpoint
# a single request can queue thousands of expensive calls. Pick a current, cost-
# appropriate model and set the OpenRouter cap to your expected datasets/day.
LLM_MODEL=openai/gpt-4-turbo

# --- Postgres job queue (password required; user/db have defaults) ---
POSTGRES_USER=tagger
# Generate a strong value, e.g.:  openssl rand -base64 32
POSTGRES_PASSWORD=generate_a_strong_random_password
POSTGRES_DB=eegdash_queue

# --- MongoDB write-back via the EEGDash API (required for the worker) ---
# On the indexing host the EEGDash API is the eegdash-api container on the shared
# network, so use the internal URL (no public TLS round-trip).
EEGDASH_API_URL=http://eegdash-api:3000
# SECURITY: this is the competition API's production-write ADMIN_TOKEN. Reusing it
# puts a full write credential into this internet-adjacent service (visible via
# `docker inspect`). PREFER a separate, write-scoped token if the EEGDash API can
# mint one. If reused, rotation must be coordinated with the competition stack's
# .env (both change together, both reload).
EEGDASH_ADMIN_TOKEN=must_match_the_eegdash_api_ADMIN_TOKEN
MONGODB_DATABASE=eegdash

# --- Edge auth (NOT consumed by the app) ---
# The cost-spending endpoints have NO app-level auth. Gate them at Caddy with this
# value (see deploy/caddy/tagger.eegdash.org.caddy). Generate: openssl rand -hex 32
# This is a reminder to set it in the Caddyfile; the app does not read it.
# TAGGER_EDGE_API_KEY=set_this_in_the_caddyfile_header_check
