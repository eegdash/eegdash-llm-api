# Required: OpenRouter API key
OPENROUTER_API_KEY=your_key_here

# Required for the gated routes: clients send it as the X-API-Key header on
# POST /api/v1/tag, /tag/enqueue*, DELETE /api/v1/cache*. Empty -> those
# routes return 503. Generate with: openssl rand -hex 32
TAGGER_API_KEY=

# Optional: LLM model to use (defaults to openai/gpt-4-turbo)
LLM_MODEL=openai/gpt-4-turbo

# Optional: Cache directory (defaults to /tmp/eegdash-llm-api/cache)
CACHE_DIR=/tmp/eegdash-llm-api/cache

# Optional: Override library's bundled config paths (usually not needed)
# The API uses configs bundled with eegdash-llm-tagger package by default
# FEW_SHOT_PATH=/custom/path/few_shot_examples.json
# PROMPT_PATH=/custom/path/prompt.md
